# This is a template Dockerfile for building .NET services
# Create individual Dockerfiles for each service based on this template

# Build stage
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy solution and project files
COPY ["Directory.Build.props", "."]
COPY ["Directory.Build.targets", "."]
COPY ["Directory.Packages.props", "."]
COPY ["global.json", "."]
COPY ["nuget.config", "."]

# Copy all project files (adjust paths for specific services)
COPY ["src/", "src/"]

# Restore dependencies
RUN dotnet restore "src/<SERVICE_NAME>/<SERVICE_NAME>.csproj"

# Build the project
RUN dotnet build "src/<SERVICE_NAME>/<SERVICE_NAME>.csproj" -c Release -o /app/build

# Publish stage
FROM build AS publish
RUN dotnet publish "src/<SERVICE_NAME>/<SERVICE_NAME>.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS final
WORKDIR /app
EXPOSE 8080

# Copy published files
COPY --from=publish /app/publish .

# Set entry point
ENTRYPOINT ["dotnet", "<SERVICE_NAME>.dll"]
